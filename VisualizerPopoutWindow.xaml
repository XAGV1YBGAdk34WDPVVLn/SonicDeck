<Window x:Class="SonicDeck.VisualizerPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="SonicDeck — Detached Visualizer (Press F11 for Fullscreen, Esc to Dock Back)"
        Width="1120"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#050811"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove">

    <Grid>
        <!-- Full-Window Hardware-Accelerated SkiaSharp Visualizer Surface -->
        <skia:SKElement x:Name="PopoutSkiaCanvas"
                        PaintSurface="PopoutSkiaCanvas_PaintSurface"
                        MouseDown="PopoutSkiaCanvas_MouseDown"
                        MouseMove="PopoutSkiaCanvas_MouseMove"
                        MouseUp="PopoutSkiaCanvas_MouseUp"
                        MouseWheel="PopoutSkiaCanvas_MouseWheel"
                        MouseLeave="PopoutSkiaCanvas_MouseLeave"
                        Cursor="Cross"/>

        <!-- Auto-Hiding Floating HUD Control Bar (Appears on Mouse Move) -->
        <Border x:Name="HudBar"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,14,0,0"
                Background="#E00F172A"
                BorderBrush="#38BDF8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,7">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="SONICDECK"
                           Foreground="#38BDF8"
                           FontWeight="ExtraBold"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBlock Text="Mode:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                <ComboBox x:Name="CmbPopoutMode"
                          Width="225"
                          SelectionChanged="CmbPopoutMode_SelectionChanged"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>

                <TextBlock Text="RTA Style:" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                <ComboBox x:Name="CmbPopoutRtaStyle"
                          Width="195"
                          SelectionChanged="CmbPopoutRtaStyle_SelectionChanged"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>

                <TextBlock Text="Theme (T):" Foreground="#A855F7" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                <ComboBox x:Name="CmbPopoutTheme"
                          Width="185"
                          SelectionChanged="CmbPopoutTheme_SelectionChanged"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24" Height="10" CornerRadius="3" Background="{Binding SwatchBrush}" BorderBrush="#334155" BorderThickness="1" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <Ellipse Width="6" Height="6" Fill="{Binding EqAccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox x:Name="ChkPopoutEqOverlay"
                          Content="EQ Overlay"
                          IsChecked="True"
                          Checked="ChkPopoutEqOverlay_Changed"
                          Unchecked="ChkPopoutEqOverlay_Changed"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>

                <Button x:Name="BtnToggleFullscreen"
                        Content="⛶ Fullscreen (F11)"
                        Click="BtnToggleFullscreen_Click"
                        Background="#1E1B4B"
                        BorderBrush="#8B5CF6"
                        Foreground="#E0E7FF"
                        Margin="0,0,8,0"
                        Padding="10,4"/>

                <Button Content="↙ Dock Back (Esc)"
                        Click="BtnDockBack_Click"
                        Background="#065F46"
                        BorderBrush="#10B981"
                        Foreground="#ECFDF5"
                        Padding="10,4"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
